# Copy this file to `.env` (same folder) and fill in your own key.
#   cp .env.example .env
#
# You do not have to edit this by hand — CONDUCTOR shows a setup screen on first
# run that writes these values for you.

# Which backend answers. The launch screen groups them into tiers (Free / Free
# trial / Paid / Local); limits, links and data notes live in
# llm_agent/provider_catalog.yaml.
#   google      Gemini API (free or paid tier: GEMINI_TIER)
#   nvidia      NVIDIA Build free endpoints
#   openrouter  OpenRouter (free or paid models: OPENROUTER_TIER)
#   deepseek    DeepSeek API (pay-as-you-go, after a reported signup credit)
#   openai      OpenAI, or any OpenAI-compatible endpoint via OPENAI_BASE_URL
#   anthropic   Anthropic (Claude)
#   ollama      a local model — no grid data leaves your machine
LLM_PROVIDER=google

# ---------------------------------------------------------------------------
# Google Gemini API  (LLM_PROVIDER=google)
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here

# Model id to use (optional; this is the default)
# Note: free-tier Gemma models cap input at 16K tokens/minute, which is below
# this agent's per-call system-prompt + tool-schema overhead. Use a Flash model.
GEMINI_MODEL=gemini-3.5-flash-lite

# free (default) or paid. On the free tier quotas are per model: when the
# active model's daily quota is spent, CONDUCTOR switches to the next model of
# the fallback chain and says so.
GEMINI_TIER=free
# Comma-separated fallback chain (free tier only); empty = the catalog's
# (gemini-3.5-flash-lite, gemini-3.1-flash-lite).
GEMINI_FALLBACK_MODELS=

# How hard a thinking-capable model reasons before answering:
#   minimal | low | medium | high
# Leave it EMPTY (the default) to let the model pick its own budget, which is
# what CONDUCTOR has always done — reasoning is on either way. Pin a level only
# to trade answer quality against speed and cost. Models that predate thinking
# levels ignore it; if one rejects it outright, CONDUCTOR retries without it.
GEMINI_THINKING_LEVEL=

# ---------------------------------------------------------------------------
# OpenAI  (LLM_PROVIDER=openai)
# ---------------------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys. Paid per token — there is
# no free tier. Use Ollama if you would rather not pay.
OPENAI_API_KEY=your-openai-api-key-here

# Model id to use (optional; this is the default). It must support tool
# calling: CONDUCTOR drives the grid entirely through tools, so a model without
# it can only chat. Check the current model list at
# https://platform.openai.com/docs/models — the launch screen also checks that
# the model is still offered, and mentions a newer model of the same family.
OPENAI_MODEL=gpt-6-luna

# How hard a reasoning model thinks before answering:
#   none | low | medium | high | xhigh
# A turn plans several tool calls and then reasons over the results, so
# lowering this trades answer quality for speed and cost. Leave it empty to
# omit the parameter entirely — needed for models that do not reason and for
# OpenAI-compatible servers that reject it (CONDUCTOR also drops it
# automatically if the server says it is unsupported).
OPENAI_REASONING_EFFORT=medium

# Which OpenAI endpoint to drive: auto | chat | responses
#
# This matters more than it looks. Newer reasoning models refuse function tools
# combined with any reasoning effort on /v1/chat/completions — and CONDUCTOR
# sends tools on every turn — so reasoning is only reachable via /v1/responses.
# "auto" picks /v1/responses when a reasoning level is set and OPENAI_BASE_URL
# is OpenAI's own, and /v1/chat/completions otherwise, because most
# OpenAI-compatible servers implement only the latter. Force either with
# "chat" or "responses".
OPENAI_API=auto

# Point this at any endpoint speaking the OpenAI chat-completions dialect —
# Azure OpenAI, OpenRouter, Groq, a local vLLM or llama.cpp server. Only the
# base changes; nothing else in the provider does.
OPENAI_BASE_URL=https://api.openai.com/v1

# Hosted generation is quick, but a turn carries ~28k tokens of prompt and can
# fan out over several tool calls.
OPENAI_TIMEOUT_S=180

# ---------------------------------------------------------------------------
# Anthropic  (LLM_PROVIDER=anthropic)
# ---------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys. Paid per token —
# there is no free tier. Use Ollama if you would rather not pay.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model id to use (optional; this is the default). It must support tool
# calling — CONDUCTOR drives the grid entirely through tools.
# Haiku is the cheapest Claude model; use claude-sonnet-5-5 or claude-opus-5-5
# for a more capable tier. If you pin the older claude-haiku-4-5, note it
# predates adaptive thinking — the provider sends it a token budget instead, so
# ANTHROPIC_EFFORT below still applies.
ANTHROPIC_MODEL=claude-haiku-5-5

# How hard the model thinks before answering:
#   low | medium | high | xhigh | max
# Depth of the thinking below. There is no "off" rung here — to spend less,
# lower this rather than disabling thinking. `max` earns its cost only on hard
# problems. Leave EMPTY to take the API default (high). On a 4.5-generation
# model (Haiku 4.5) these map onto thinking-token budgets instead.
ANTHROPIC_EFFORT=medium

# Adaptive thinking: the model decides when and how much to think, with the
# effort above setting the depth. Set to 0 to disable, which the API accepts
# only at effort `high` or below. (The older fixed thinking-token budget is
# removed on current models and is rejected outright.)
ANTHROPIC_THINKING=1

# Output cap. Answers here are operator summaries rather than documents, so
# this is generous without inviting a timeout on the non-streaming path.
ANTHROPIC_MAX_TOKENS=16000

# Only for gateways and proxies speaking the Anthropic wire format.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Hosted generation is quick, but a turn carries ~28k tokens of prompt and a
# thinking model can spend a while on top.
ANTHROPIC_TIMEOUT_S=180

# ---------------------------------------------------------------------------
# Ollama  (LLM_PROVIDER=ollama) — runs locally, no API key, no data sent out
# ---------------------------------------------------------------------------
# The model must support tool calling; CONDUCTOR drives the grid entirely
# through tools. Check with: ollama show <model>
# On Apple Silicon the `-mlx` tags run noticeably faster.
OLLAMA_MODEL=gemma4:12b-mlx
OLLAMA_HOST=http://localhost:11434

# Context window. This is NOT optional tuning: Ollama defaults to ~4096 and
# silently discards the front of an over-long prompt — dropping the system
# prompt first, with no error. The system prompt plus 27 tool schemas measures
# ~28k tokens before any conversation, so 32768 leaves almost no room for
# history. Lower this only if the model won't fit in memory, and expect shorter
# conversations; CONDUCTOR refuses over-long prompts rather than truncating.
OLLAMA_NUM_CTX=65536

# Tokens held back from the window for the model's reply.
OLLAMA_OUTPUT_RESERVE=4096

# Local generation is slow, especially the first call while the model loads.
OLLAMA_TIMEOUT_S=600

# ---------------------------------------------------------------------------
# NVIDIA Build free endpoints  (LLM_PROVIDER=nvidia)
# ---------------------------------------------------------------------------
# Key (starts with nvapi-) at https://build.nvidia.com/settings/api-keys — needs
# a free NVIDIA Developer account with phone verification. For development and
# testing only (NVIDIA's trial terms).
NVIDIA_API_KEY=
# An allowlisted model (validated against NVIDIA's live model list at launch),
# fastest first as measured on a 4-tool question (Oct 2026):
#   nvidia/nemotron-3-super-120b-a12b | nvidia/nemotron-3-ultra-550b-a55b |
#   nvidia/nemotron-3.5-lightning-30b-a3b | z-ai/glm-5.3 | z-ai/glm-5.3-flash |
#   deepseek-ai/deepseek-v4.1-flash
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Free endpoints can be slow; a request waits this long (seconds) before it is
# a timeout. A timeout is retried once, then reported.
NVIDIA_TIMEOUT_S=180
# Thinking, per model as its card documents it (empty = the model's default):
#   Nemotron 3 Super / 3.5 Lightning: off | on      Nemotron 3 Ultra: off | medium | on
#   GLM 5.3 / 5.3 Flash: low | high | max (their default is max — slow)
#   DeepSeek V4.1 Flash: no control documented
NVIDIA_THINKING=

# ---------------------------------------------------------------------------
# OpenRouter  (LLM_PROVIDER=openrouter)
# ---------------------------------------------------------------------------
# Key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# free (default; models ending in :free) or paid
OPENROUTER_TIER=free
# Chosen on the launch screen from the live list of qualifying models.
OPENROUTER_MODEL=
# Free tier: send the next two qualifying models as server-side fallbacks (1/0).
OPENROUTER_FALLBACKS=1
# Thinking via OpenRouter's reasoning.effort: none | low | medium | high, sent
# only to models that list support for it (empty = the model's default).
OPENROUTER_THINKING=
# Free tier: only providers that do not collect data (provider.data_collection
# = "deny"). Off by default: when tested (Oct 2026) it left no free model with
# an allowed provider. The launch screen warns that free-model providers may
# store prompts and train on them (1/0).
OPENROUTER_DENY_DATA_COLLECTION=0
# A free model qualifies with at least this much context ...
OPENROUTER_MIN_CONTEXT=131072
# ... and when it does not retire within this many days.
FREE_MODEL_EXPIRY_GRACE_DAYS=14

# ---------------------------------------------------------------------------
# DeepSeek  (LLM_PROVIDER=deepseek)
# ---------------------------------------------------------------------------
# Key at https://platform.deepseek.com/api_keys. Pay-as-you-go (new accounts
# reportedly get a one-time signup credit first). Data is stored in the People's Republic of China. The same
# model is free on NVIDIA Build.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# Estimates and caches
# ---------------------------------------------------------------------------
# How long discovered model lists (OpenRouter, NVIDIA, Google) are kept, in hours.
DISCOVERY_CACHE_TTL_H=24
# Cards warn when the catalog's figures were last verified longer ago than this.
CATALOG_STALE_DAYS=60
# Model calls per question used by the estimates. Empty = the running average
# measured on this machine (4 until there is data).
CONDUCTOR_CALLS_PER_QUESTION=
# Shorten earlier questions' tool results in what is sent: auto (on for free
# tiers), on, off.
CONDUCTOR_COMPACT_HISTORY=auto
