# Copy this file to `.env` (same folder) and fill in your own key.
#   cp .env.example .env
#
# You do not have to edit this by hand — CONDUCTOR shows a setup screen on first
# run that writes these values for you.

# Which backend answers: "google" (hosted) or "ollama" (fully local).
LLM_PROVIDER=google

# ---------------------------------------------------------------------------
# Google Gemini API  (LLM_PROVIDER=google)
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here

# Model id to use (optional; this is the default)
# Note: free-tier Gemma models cap input at 16K tokens/minute, which is below
# this agent's per-call system-prompt + tool-schema overhead. Use a Flash model.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Ollama  (LLM_PROVIDER=ollama) — runs locally, no API key, no data sent out
# ---------------------------------------------------------------------------
# The model must support tool calling; CONDUCTOR drives the grid entirely
# through tools. Check with: ollama show <model>
# On Apple Silicon the `-mlx` tags run noticeably faster.
OLLAMA_MODEL=gemma4:12b-mlx
OLLAMA_HOST=http://localhost:11434

# Context window. This is NOT optional tuning: Ollama defaults to ~4096 and
# silently discards the front of an over-long prompt — dropping the system
# prompt first, with no error. The system prompt plus 20 tool schemas measures
# ~25k tokens before any conversation, so 32768 leaves almost no room for
# history. Lower this only if the model won't fit in memory, and expect shorter
# conversations; CONDUCTOR refuses over-long prompts rather than truncating.
OLLAMA_NUM_CTX=65536

# Tokens held back from the window for the model's reply.
OLLAMA_OUTPUT_RESERVE=4096

# Local generation is slow, especially the first call while the model loads.
OLLAMA_TIMEOUT_S=600
