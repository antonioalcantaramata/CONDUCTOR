# Real datastream map — operational metadata, never committed.
backend/datastream_map.local.json

# What-if evaluation runs (python -m evaluation.whatif run)
evaluation_runs/

# Local LLM state: usage counts, discovery caches, tool-calling test results.
llm_agent/.cache/

# MkDocs build output (published by .github/workflows/docs.yml)
site/
